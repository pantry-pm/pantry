#!/bin/sh

set -e

d="$(cd "$(dirname "$0")/../.." && pwd)"
pkgx_dir="$(cd "$d/.." && pwd)"

# Git sources gettext.sh. Source the dependency's real shell library, whose
# functions must return to Git, rather than a command launcher under .bin.
for gettext_bin in "$pkgx_dir"/gnu.org/gettext/v*/bin; do
    [ -f "$gettext_bin/gettext.sh" ] || continue
    export PATH="$gettext_bin:$PATH"
    break
done

# Native packages share a relocatable installation tree. ELF dependency paths
# from the build host are not available after installation, so provide the
# installed libraries before launching Git (including curl's dependencies).
if [ "$(uname -s)" = Linux ]; then
    libraries="${LD_LIBRARY_PATH:-}"
    for dependency_lib in "$pkgx_dir"/*/v*/lib "$pkgx_dir"/*/*/v*/lib "$pkgx_dir"/*/*/*/v*/lib; do
        [ -d "$dependency_lib" ] || continue
        libraries="${libraries:+$libraries:}$dependency_lib"
    done
    if [ -n "$libraries" ]; then
        export LD_LIBRARY_PATH="$libraries"
    fi
fi

# Only set GIT_SSL_CAINFO if no system CA store exists
if [ -z "$GIT_SSL_CAINFO" ]; then
    for sys_ca in \
        /etc/ssl/certs/ca-certificates.crt \
        /etc/pki/tls/certs/ca-bundle.crt \
        /etc/ssl/cert.pem \
        /usr/local/etc/openssl/cert.pem
    do
        [ -f "$sys_ca" ] && break
    done

    if [ ! -f "$sys_ca" ]; then
        for f in "$pkgx_dir"/curl.se/ca-certs/v*/ssl/cert.pem; do
        [ -f "$f" ] && export GIT_SSL_CAINFO="$f" && break
        done
    fi
fi

# This function searches through the provided arguments
# to find the first non-option argument, which is assumed
# to be the git subcommand.
find_git_subcommand() {
  skip_next=0  # Flag to indicate if the next argument should be skipped.

  for arg in "$@"; do
    # If the skip_next flag is set, skip this argument.
    if [ "$skip_next" -eq 1 ]; then
      skip_next=0
      continue
    fi

    # Check for options that require skipping the next argument.
    case $arg in
      -C | --git-dir | --work-tree | --namespace | --super-prefix | --config-env | -c)
        skip_next=1  # The next argument is a value for these options.
        continue
        ;;
      -*)
        continue  # Skip other options that start with '-'.
        ;;
    esac

    # If we reach this point, it's likely the git subcommand.
    echo "$arg"
    return
  done
}

prefix="$(cd "$(dirname "$0")/.." && pwd)"
libexec="$prefix/libexec"

# git's compiled-in template path is the build prefix (e.g. /opt/git-scm.org/
# v*+brewing/share/git-core/templates), which doesn't exist once the package is
# relocated — so `git init`/`clone` warns "templates not found". Point it at the
# templates that ship inside this package instead.
if [ -z "$GIT_TEMPLATE_DIR" ] && [ -d "$prefix/share/git-core/templates" ]; then
  export GIT_TEMPLATE_DIR="$prefix/share/git-core/templates"
fi

# extract the git subcommand
cmd=$(find_git_subcommand "$@")

_provides() {
  if foo="$(pkgx pkgx^1 --provider git-"$cmd")"; then
    echo "$foo"
  else
    # syncing is slow but let’s be sure about it
    pkgx pkgx^1 --sync --provider git-"$cmd"
  fi
}

_is_alias() {
  "$libexec/git" config --get-regexp '^alias\.' | awk '{ print $1 }' | sed 's/alias\.//' | grep -qx "$cmd"
}

if [ -z "$cmd" ]; then
  exec "$libexec/git" "$@"
elif [ -x "$libexec/git-$cmd" ] && [ -f "$libexec/git-$cmd" ]; then
  exec "$libexec/git" "$@"
elif type "git-$cmd" >/dev/null 2>&1; then
  exec "$libexec/git" "$@"
elif ! _is_alias && command -v pkgx >/dev/null 2>&1 && pkg=$(_provides); then
  exec pkgx +"$pkg" "$libexec/git" "$@"
else
  exec "$libexec/git" "$@"
fi
