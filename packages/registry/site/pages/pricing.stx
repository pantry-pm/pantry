<!-- Plans and marketplace fees -->

<section class="py-12 pb-20">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-10 animate-fade-in">
      <h1 class="text-3xl font-semibold tracking-tight mb-3">Plans</h1>
      <p class="text-sm max-w-2xl mx-auto" style="color: var(--fg-muted);">
        Publishing is free and installing is free — you just need an account for an API token.
        A plan insures the builds that depend on what you install, and halves what it costs to
        <em>sell</em> a package.
      </p>
    </div>

    <div class="grid gap-4 mb-12 animate-fade-in-delay" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
      @foreach (plans as plan)
      <div class="border rounded-lg p-5 flex flex-col" style="background: var(--bg-subtle); border-color: {{ plan.featured ? 'var(--accent)' : 'var(--border)' }};">
        <div class="flex items-baseline justify-between mb-1">
          <p class="uppercase tracking-widest" style="font-size: 0.6875rem; color: var(--fg-subtle);">{{ plan.name }}</p>
          @if (plan.featured)
          <span class="rounded px-1.5 py-0.5" style="font-size: 0.625rem; background: var(--accent); color: var(--bg);">Most popular</span>
          @endif
        </div>
        <p class="text-2xl font-semibold">{{ plan.formattedPrice }}</p>
        <p class="mb-4 pb-4 border-b border-[var(--border)]" style="font-size: 0.75rem; color: var(--fg-subtle);">{{ plan.tagline }}</p>

        <p class="uppercase tracking-widest mb-2" style="font-size: 0.625rem; color: var(--fg-subtle);">Publishing</p>
        <ul class="flex flex-col gap-1.5 mb-4" style="font-size: 0.8125rem; color: var(--fg-muted);">
          @foreach (plan.publishing as item)
          <li>{{ item }}</li>
          @endforeach
        </ul>

        <p class="uppercase tracking-widest mb-2" style="font-size: 0.625rem; color: var(--fg-subtle);">Consuming</p>
        <ul class="flex flex-col gap-1.5 mb-5" style="font-size: 0.8125rem; color: var(--fg-muted);">
          @foreach (plan.consuming as item)
          <li>{{ item }}</li>
          @endforeach
        </ul>

        <p class="mb-3" style="font-size: 0.6875rem; color: var(--fg-subtle);">
          Selling a package costs {{ plan.sellingFee }} per sale &mdash; <a href="#what-selling-costs" class="hvr-accent transition-colors" style="color: var(--fg-subtle); text-decoration: underline;">details</a>
        </p>

        @if (plan.id !== 'free')
        <a href="/account?plan={{ plan.id }}" class="mt-auto rounded-lg px-4 py-2.5 font-medium text-sm text-center transition-colors" style="background: var(--accent); color: var(--bg);">
          Choose {{ plan.name }}
        </a>
        @else
        <a href="/signup" class="mt-auto rounded-lg px-4 py-2.5 font-medium text-sm text-center transition-colors border border-[var(--border)]" style="color: var(--fg);">
          Create an account
        </a>
        @endif
      </div>
      @endforeach
    </div>

    <div class="grid gap-4 mb-8" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
      <div class="border border-[var(--border)] rounded-lg p-5" style="background: var(--bg-subtle);">
        <h2 class="text-sm font-medium mb-2">Build insurance</h2>
        <p class="mb-3" style="font-size: 0.8125rem; color: var(--fg-muted);">
          Every artifact your build resolves is copied into your own namespace and kept there.
          When a dependency is unpublished, retagged or deleted upstream, your build still
          resolves — from bytes we verified against your lockfile's integrity hash.
        </p>
        <code class="text-xs" style="color: var(--accent);">pantry insure</code>
      </div>

      <div class="border border-[var(--border)] rounded-lg p-5" style="background: var(--bg-subtle);">
        <h2 class="text-sm font-medium mb-2">Continuous alerts</h2>
        <p class="mb-3" style="font-size: 0.8125rem; color: var(--fg-muted);">
          An audit tells you about today. This watches your lockfile against the OSV advisory
          database and your own licence policy, so the advisory published next Tuesday for the
          version you shipped last Tuesday still reaches you.
        </p>
        <code class="text-xs" style="color: var(--accent);">pantry alerts --deny AGPL-3.0</code>
      </div>

      <div class="border border-[var(--border)] rounded-lg p-5" style="background: var(--bg-subtle);">
        <h2 class="text-sm font-medium mb-2">SBOM export</h2>
        <p class="mb-3" style="font-size: 0.8125rem; color: var(--fg-muted);">
          CycloneDX or SPDX for everything you install, with hashes we computed from the bytes
          we stored rather than claims copied out of a manifest. Deterministic, so regenerating
          it doesn't churn your repo.
        </p>
        <code class="text-xs" style="color: var(--accent);">pantry sbom --format spdx</code>
      </div>

      <div class="border border-[var(--border)] rounded-lg p-5" style="background: var(--bg-subtle);">
        <h2 class="text-sm font-medium mb-2">Team seats</h2>
        <p class="mb-3" style="font-size: 0.8125rem; color: var(--fg-muted);">
          Up to ten people share one account's packages, one mirror, one watch list — and one
          purchase of any paid package. A departing teammate doesn't take the licence with them.
        </p>
        <code class="text-xs" style="color: var(--accent);">pantry team add dev@yourco.com</code>
      </div>
    </div>

    <div id="what-selling-costs" class="border border-[var(--border)] rounded-lg p-5 mb-6" style="background: var(--bg-subtle);">
      <h2 class="text-xs uppercase tracking-widest font-medium mb-3" style="color: var(--fg-subtle);">What selling costs</h2>
      <ul class="flex flex-col gap-2" style="font-size: 0.875rem; color: var(--fg-muted);">
        <li><strong>The fee is what you pay pantry for each sale.</strong> List a package at $10 and sell one copy: $1 goes to pantry on Free, or 50&cent; on a plan.</li>
        <li>It comes out of the sale rather than being added to it — the buyer pays the price you listed, and nothing more.</li>
        <li>A sale that <strong>started on this site</strong> adds {{ discoveryFee }} on top: we put the package in front of a buyer who wasn't looking for it. A sale you bring yourself — a link you sent, or <code class="font-mono">pantry buy</code> in a terminal — doesn't.</li>
        <li>Payment processing and any sales tax are separate, and settle against your own Stripe account.</li>
        <li>Nothing is charged until something sells. You never pay to download your own package, and versions you mark free stay free for everyone.</li>
      </ul>
      <p class="mt-3" style="font-size: 0.8125rem; color: var(--fg-subtle);">
        Lifetime download totals are shown for every package on every plan. What a plan buys is
        the depth — the day-by-day timeline and per-version breakdowns beyond 30 days.
      </p>
    </div>

    <div class="border border-[var(--border)] rounded-lg p-5" style="background: var(--bg-subtle);">
      <h2 class="text-xs uppercase tracking-widest font-medium mb-3" style="color: var(--fg-subtle);">From the terminal</h2>
      <div class="flex flex-col gap-2 font-mono text-xs">
        <div class="bg-[var(--bg)] rounded-md px-3 py-2 border border-[var(--border)]">
          <code style="color: var(--accent);">pantry plan</code>
          <span style="color: var(--fg-subtle);"> — what each plan costs and unlocks</span>
        </div>
        <div class="bg-[var(--bg)] rounded-md px-3 py-2 border border-[var(--border)]">
          <code style="color: var(--accent);">pantry subscribe pro</code>
          <span style="color: var(--fg-subtle);"> — subscribe in a browser</span>
        </div>
        <div class="bg-[var(--bg)] rounded-md px-3 py-2 border border-[var(--border)]">
          <code style="color: var(--accent);">pantry price set my-package 9.00</code>
          <span style="color: var(--fg-subtle);"> — charge for a package</span>
        </div>
        <div class="bg-[var(--bg)] rounded-md px-3 py-2 border border-[var(--border)]">
          <code style="color: var(--accent);">pantry insure</code>
          <span style="color: var(--fg-subtle);"> — mirror this project's dependencies</span>
        </div>
      </div>
      <p class="mt-4" style="font-size: 0.8125rem; color: var(--fg-subtle);">
        Full detail in <a href="/docs" class="hvr-accent transition-colors" style="color: var(--accent);">the docs</a>.
      </p>
    </div>

    @if (!paymentsEnabled)
    <p class="mt-6 text-center" style="font-size: 0.8125rem; color: var(--fg-subtle);">
      This registry has no payment provider configured, so plans can't be purchased here yet.
    </p>
    @endif
  </div>
</section>
