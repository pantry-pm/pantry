<!-- Plans and marketplace fees -->

<section class="py-12 pb-20">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-10 animate-fade-in">
      <h1 class="text-3xl font-semibold tracking-tight mb-3">Plans</h1>
      <p class="text-sm max-w-xl mx-auto" style="color: var(--fg-muted);">
        Publishing is free, and always will be. A plan lowers what the registry takes
        when you sell a package, and unlocks the things a serious publisher wants anyway.
      </p>
    </div>

    <div class="grid gap-4 mb-10 animate-fade-in-delay" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));">
      @foreach (plans as plan)
      <div class="border rounded-lg p-5 flex flex-col" style="background: var(--bg-subtle); border-color: {{ plan.featured ? 'var(--accent)' : 'var(--border)' }};">
        <p class="uppercase tracking-widest mb-1" style="font-size: 0.6875rem; color: var(--fg-subtle);">{{ plan.name }}</p>
        <p class="text-2xl font-semibold mb-1">{{ plan.formattedPrice }}</p>
        <p class="mb-4" style="font-size: 0.8125rem; color: var(--accent);">{{ plan.commission }} of each sale</p>

        <ul class="flex flex-col gap-2 mb-5" style="font-size: 0.8125rem; color: var(--fg-muted);">
          <li>{{ plan.privateLabel }}</li>
          <li>{{ plan.analyticsLabel }}</li>
          <li>{{ plan.artifactLabel }}</li>
          <li>{{ plan.buildsLabel }}</li>
          <li>{{ plan.seatsLabel }}</li>
        </ul>

        @if (plan.id !== 'free')
        <a href="/account?plan={{ plan.id }}" class="mt-auto rounded-lg px-4 py-2.5 font-medium text-sm text-center transition-colors" style="background: var(--accent); color: var(--bg);">
          Choose {{ plan.name }}
        </a>
        @else
        <p class="mt-auto text-center" style="font-size: 0.8125rem; color: var(--fg-subtle);">No signup needed</p>
        @endif
      </div>
      @endforeach
    </div>

    <div class="border border-[var(--border)] rounded-lg p-5 mb-6" style="background: var(--bg-subtle);">
      <h2 class="text-xs uppercase tracking-widest font-medium mb-3" style="color: var(--fg-subtle);">How the fee works</h2>
      <ul class="flex flex-col gap-2" style="font-size: 0.875rem; color: var(--fg-muted);">
        <li>The commission comes out of the seller's side. Buyers pay the listed price, and nothing else.</li>
        <li>A sale that <strong>started on this site</strong> adds a {{ discoveryFee }} discovery fee — we put the package in front of a buyer who wasn't looking for it. A sale you bring yourself (a link you sent, <code class="font-mono">pantry buy</code>) doesn't.</li>
        <li>Card processing is Stripe's, settled against your connected account, so the percentage above is what the registry keeps rather than what it charges.</li>
        <li>You never pay to download your own package, and versions you mark free stay free for everyone.</li>
      </ul>
    </div>

    <div class="border border-[var(--border)] rounded-lg p-5" style="background: var(--bg-subtle);">
      <h2 class="text-xs uppercase tracking-widest font-medium mb-3" style="color: var(--fg-subtle);">From the terminal</h2>
      <div class="flex flex-col gap-2 font-mono text-xs">
        <div class="bg-[var(--bg)] rounded-md px-3 py-2 border border-[var(--border)]">
          <code style="color: var(--accent);">pantry plan</code>
          <span style="color: var(--fg-subtle);"> — what each plan costs and unlocks</span>
        </div>
        <div class="bg-[var(--bg)] rounded-md px-3 py-2 border border-[var(--border)]">
          <code style="color: var(--accent);">pantry subscribe pro</code>
          <span style="color: var(--fg-subtle);"> — subscribe in a browser</span>
        </div>
        <div class="bg-[var(--bg)] rounded-md px-3 py-2 border border-[var(--border)]">
          <code style="color: var(--accent);">pantry price set my-package 9.00</code>
          <span style="color: var(--fg-subtle);"> — charge for a package</span>
        </div>
      </div>
    </div>

    @if (!paymentsEnabled)
    <p class="mt-6 text-center" style="font-size: 0.8125rem; color: var(--fg-subtle);">
      This registry has no payment provider configured, so plans can't be purchased here yet.
    </p>
    @endif
  </div>
</section>
