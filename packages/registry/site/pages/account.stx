<!-- Account / Token Management page -->

<section class="py-12 pb-20">
  <div class="max-w-3xl mx-auto px-6">
    <!-- Account Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8 animate-fade-in">
      <div>
        <h1 class="text-2xl font-semibold mb-1">Account</h1>
        <p class="text-sm" style="color: var(--fg-muted); overflow-wrap: anywhere;">
          Signed in as <span class="font-medium" style="color: var(--fg);">{{ user.name }}</span>
          <span style="color: var(--fg-subtle);">({{ user.email }})</span>
        </p>
      </div>
      <form method="POST" action="/auth/logout" id="logout-form" style="display: inline;">
        <button
          type="button"
          class="text-sm px-3 py-1.5 rounded-md border border-[var(--border)] transition-colors hover:border-[var(--border-hover)]"
          style="color: var(--fg-muted); background: none; cursor: pointer;"
          id="logout-btn"
        >
          Log out
        </button>
      </form>
    </div>

    <!-- Publisher dashboard -->
    <div class="mb-8 p-4 rounded-lg border border-[var(--border)] animate-fade-in" style="background: var(--bg-subtle);">
      <h2 class="text-lg font-semibold mb-2">Published packages</h2>
      <p class="text-sm mb-4" style="color: var(--fg-muted);">
        View download stats, edit package metadata, and configure npm publishing settings.
      </p>
      <a href="/publisher" class="inline-block text-sm px-4 py-2 rounded-lg font-medium transition-colors" style="background: var(--accent); color: var(--bg);">
        Open publisher dashboard
      </a>
    </div>

    <p id="account-status" role="alert" class="text-sm mb-4" style="color: var(--red);" hidden></p>

    <!-- API Tokens Section -->
    <div class="animate-fade-in-delay">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold">API Tokens</h2>
        <button
          type="button"
          class="text-sm px-3 py-1.5 rounded-md font-medium transition-colors"
          style="background: var(--accent); color: var(--bg); cursor: pointer;"
          id="create-token-btn"
        >
          Create token
        </button>
      </div>

      <p class="text-sm mb-6" style="color: var(--fg-muted);">
        API tokens allow you to publish packages from the command line or CI.
        Use them with <code class="font-mono text-xs px-1 py-0.5 rounded" style="background: var(--bg-muted);">Authorization: Bearer &lt;token&gt;</code>
      </p>

      <!-- New Token Alert (shown after creation) -->
      <div id="new-token-alert" class="mb-6 p-4 rounded-lg border" style="background: oklch(0.2 0.05 155); border-color: oklch(0.4 0.1 155); display: none;">
        <p class="text-sm font-medium mb-2" style="color: oklch(0.85 0.1 155);">Token created! Copy it now — it won't be shown again.</p>
        <div class="flex items-center gap-2">
          <code id="new-token-value" tabindex="-1" class="font-mono text-xs px-3 py-2 rounded flex-1 overflow-x-auto" style="background: var(--bg); color: var(--fg); border: 1px solid var(--border);"></code>
          <button class="copy-btn" data-copy="" id="copy-new-token">copy</button>
        </div>
      </div>

      <!-- Token List -->
      <div class="border border-[var(--border)] rounded-lg overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr style="background: var(--bg-subtle);">
              <th class="text-left text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);">Name</th>
              <th class="text-left text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);">ID</th>
              <th class="text-left text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);">Permissions</th>
              <th class="text-left text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);">Created</th>
              <th class="text-left text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);">Last Used</th>
              <th class="text-right text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);"></th>
            </tr>
          </thead>
          <tbody id="token-rows">
            @if (!tokens || tokens.length === 0)
            <tr id="token-empty"><td colspan="6" class="text-sm p-6" style="color: var(--fg-subtle);">No API tokens yet. Create one to start publishing.</td></tr>
            @endif
            @foreach (tokens as token)
            <tr class="border-t border-[var(--border)]" data-token-id="{{ token.id }}">
              <td class="px-4 py-3 text-sm font-medium">{{ token.name }}</td>
              <td class="px-4 py-3 text-xs font-mono" style="color: var(--fg-subtle);">{{ token.id }}</td>
              <td class="px-4 py-3">
                @foreach (token.permissions as perm)
                <span class="inline-block text-xs px-1.5 py-0.5 rounded mr-1" style="background: var(--bg-muted); color: var(--fg-muted);">{{ perm }}</span>
                @endforeach
              </td>
              <td class="px-4 py-3 text-xs" style="color: var(--fg-subtle);">{{ token.createdAt.split('T')[0] }}</td>
              <td class="px-4 py-3 text-xs" style="color: var(--fg-subtle);">{{ token.lastUsedAt ? token.lastUsedAt.split('T')[0] : 'never' }}</td>
              <td class="px-4 py-3 text-right">
                <button
                  type="button"
                  class="text-xs px-2 py-1 rounded border border-[var(--border)] transition-colors hover:border-[var(--red)]"
                  style="color: var(--red); background: none; cursor: pointer;"
                  aria-label="Revoke {{ token.name }}" data-delete-token="{{ token.id }}"
                >
                  revoke
                </button>
              </td>
            </tr>
            @endforeach
          </tbody>
        </table>
      </div>

    </div>

    <!-- Create Token Dialog -->
    <dialog id="create-token-dialog" class="shortcuts-dialog" aria-label="Create API Token">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-semibold">Create API Token</h2>
          <button id="close-token-dialog" style="background: none; border: none; cursor: pointer; color: var(--fg-subtle); padding: 0.25rem;" aria-label="Close">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <p id="token-error" role="alert" class="text-sm mb-4" style="color: var(--red);" hidden></p>
        <form id="create-token-form" class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="token-name" class="text-sm font-medium" style="color: var(--fg-muted);">Token name</label>
            <input
              type="text"
              id="token-name"
              autofocus
              maxlength="255"
              required
              placeholder="e.g., CI deploy token"
              class="bg-[var(--bg-subtle)] border border-[var(--border)] rounded-lg px-3 py-2 outline-none transition-colors focus:border-[var(--accent)]"
              style="color: var(--fg); font-size: 0.875rem;"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-sm font-medium" style="color: var(--fg-muted);">Permissions</label>
            <div class="flex gap-3">
              <label class="flex items-center gap-2 text-sm cursor-pointer" style="color: var(--fg-muted);">
                <input type="checkbox" id="perm-publish" checked class="accent-[var(--accent)]" />
                publish
              </label>
              <label class="flex items-center gap-2 text-sm cursor-pointer" style="color: var(--fg-muted);">
                <input type="checkbox" id="perm-read" checked class="accent-[var(--accent)]" />
                read
              </label>
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="token-expiry" class="text-sm font-medium" style="color: var(--fg-muted);">Expiration</label>
            <select
              id="token-expiry"
              class="bg-[var(--bg-subtle)] border border-[var(--border)] rounded-lg px-3 py-2 outline-none transition-colors focus:border-[var(--accent)]"
              style="color: var(--fg); font-size: 0.875rem;"
            >
              <option value="">No expiration</option>
              <option value="30">30 days</option>
              <option value="90">90 days</option>
              <option value="365">1 year</option>
            </select>
          </div>

          <button
            type="submit"
            class="mt-2 rounded-lg px-4 py-2.5 font-medium text-sm transition-colors"
            style="background: var(--accent); color: var(--bg); cursor: pointer;"
          >
            Create token
          </button>
        </form>
    </dialog>
  </div>
</section>

<script client>
  (function() {
    var dialog = document.getElementById('create-token-dialog')
    var openButton = document.getElementById('create-token-btn')
    var form = document.getElementById('create-token-form')
    var error = document.getElementById('token-error')
    var rows = document.getElementById('token-rows')
    var accountStatus = document.getElementById('account-status')

    function showError(element, message) {
      element.setAttribute('role', 'alert')
      element.style.color = 'var(--red)'
      element.textContent = message
      element.hidden = false
    }
    function request(path, options) {
      return fetch(path, options).then(function(response) {
        return response.json().then(function(data) {
          if (!response.ok) throw new Error(data.error || 'Request failed. Please try again.')
          return data
        })
      })
    }
    openButton.addEventListener('click', function() {
      openButton.focus()
      error.hidden = true
      dialog.showModal()
    })
    document.getElementById('close-token-dialog').addEventListener('click', function() { dialog.close() })
    dialog.addEventListener('click', function(event) {
      if (event.target !== dialog) return
      var bounds = dialog.getBoundingClientRect()
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close()
    })

    function appendToken(info) {
      var empty = document.getElementById('token-empty')
      if (empty) empty.remove()
      var row = document.createElement('tr')
      row.className = 'border-t border-[var(--border)]'
      row.setAttribute('data-token-id', info.id)
      ;[info.name, info.id, info.permissions.join(', '), info.createdAt.split('T')[0], 'never'].forEach(function(value) {
        var cell = document.createElement('td')
        cell.className = 'px-4 py-3 text-sm'
        cell.textContent = value
        row.appendChild(cell)
      })
      var actions = document.createElement('td')
      actions.className = 'px-4 py-3 text-right'
      var revoke = document.createElement('button')
      revoke.type = 'button'
      revoke.className = 'copy-btn'
      revoke.textContent = 'revoke'
      revoke.setAttribute('aria-label', 'Revoke ' + info.name)
      revoke.setAttribute('data-delete-token', info.id)
      actions.appendChild(revoke)
      row.appendChild(actions)
      rows.appendChild(row)
    }
    form.addEventListener('submit', function(event) {
      event.preventDefault()
      var button = form.querySelector('button[type="submit"]')
      if (button.disabled) return
      error.hidden = true
      var permissions = []
      if (document.getElementById('perm-publish').checked) permissions.push('publish')
      if (document.getElementById('perm-read').checked) permissions.push('read')
      if (!permissions.length) { showError(error, 'Choose at least one permission.'); return }
      var body = { name: document.getElementById('token-name').value, permissions: permissions }
      var expiry = document.getElementById('token-expiry').value
      if (expiry) body.expiresInDays = Number(expiry)
      button.disabled = true
      button.textContent = 'Creating…'
      request('/auth/tokens', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        .then(function(data) {
          appendToken(data.info)
          var token = document.getElementById('new-token-value')
          token.textContent = data.token
          document.getElementById('copy-new-token').setAttribute('data-copy', data.token)
          document.getElementById('new-token-alert').style.display = 'block'
          document.getElementById('new-token-alert').dataset.tokenId = data.info.id
          form.reset()
          dialog.close()
          token.focus()
        })
        .catch(function(failure) { showError(error, failure.message || 'Unable to create token. Please try again.') })
        .finally(function() { button.disabled = false; button.textContent = 'Create token' })
    })
    rows.addEventListener('click', function(event) {
      var button = event.target.closest('[data-delete-token]')
      if (!button || button.disabled || !confirm('Revoke this token? This cannot be undone.')) return
      button.disabled = true
      request('/auth/tokens/' + encodeURIComponent(button.getAttribute('data-delete-token')), { method: 'DELETE' })
        .then(function() {
          button.closest('tr').remove()
          openButton.focus()
          if (!rows.querySelector('[data-token-id]')) {
            var empty = document.createElement('tr')
            empty.id = 'token-empty'
            var cell = document.createElement('td')
            cell.colSpan = 6
            cell.className = 'p-6 text-sm'
            cell.textContent = 'No API tokens yet. Create one to start publishing.'
            empty.appendChild(cell)
            rows.appendChild(empty)
          }
          var notice = document.getElementById('new-token-alert')
          if (notice.dataset.tokenId === button.getAttribute('data-delete-token')) {
            notice.style.display = 'none'
            delete notice.dataset.tokenId
            document.getElementById('new-token-value').textContent = ''
            document.getElementById('copy-new-token').setAttribute('data-copy', '')
          }
          accountStatus.textContent = 'Token revoked.'
          accountStatus.style.color = 'var(--fg-muted)'
          accountStatus.setAttribute('role', 'status')
          accountStatus.hidden = false
        })
        .catch(function(failure) { button.disabled = false; showError(accountStatus, failure.message) })
    })
    var logout = document.getElementById('logout-btn')
    logout.addEventListener('click', function() {
      logout.disabled = true
      request('/auth/logout', { method: 'POST' })
        .then(function() {
          try { localStorage.removeItem('pantry_session'); localStorage.removeItem('pantry_user') } catch (_) {}
          window.location.assign('/login')
        })
        .catch(function() { logout.disabled = false; showError(accountStatus, 'Unable to log out. Please try again.') })
    })
  })()
</script>
