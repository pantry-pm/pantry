<!-- Publisher dashboard — list owned packages -->

<section class="py-12 pb-20">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8 animate-fade-in">
      <div>
        <h1 class="text-2xl font-semibold mb-1">Publisher dashboard</h1>
        <p class="text-sm" style="color: var(--fg-muted);" id="publisher-subtitle">
          Manage packages you have published to pantry.dev
        </p>
      </div>
      <a href="/account" class="text-sm hvr-fg transition-colors" style="color: var(--fg-subtle);">Account & tokens →</a>
    </div>

    <div id="publisher-loading" role="status" class="text-center py-16" style="color: var(--fg-subtle);">
      <p class="text-sm">Loading your packages…</p>
    </div>

    <button id="publisher-retry" class="copy-btn mb-4" hidden>Retry loading packages</button>
    <div id="publisher-empty" class="text-center py-16 border border-[var(--border)] rounded-lg" style="background: var(--bg-subtle); display: none;">
      <p class="text-sm mb-4" style="color: var(--fg-muted);">No published packages yet.</p>
      <p class="text-xs mb-6" style="color: var(--fg-subtle); max-width: 28rem; margin-left: auto; margin-right: auto;">
        Publish from CI with <code class="font-mono px-1 py-0.5 rounded" style="background: var(--bg-muted);">pantry publish:commit './packages/*'</code>
        or semver publish with your API token.
      </p>
      <a href="/docs" class="text-sm px-4 py-2 rounded-lg" style="background: var(--accent); color: var(--bg);">Read the docs</a>
    </div>

    <div id="publisher-list" style="display: none;">
      <div class="border border-[var(--border)] rounded-lg overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr style="background: var(--bg-subtle);">
              <th class="text-left text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);">Package</th>
              <th class="text-left text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);">Latest</th>
              <th class="text-right text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);">Downloads</th>
              <th class="text-right text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);">Commits</th>
              <th class="text-right text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);">Updated</th>
              <th class="text-right text-xs font-medium uppercase tracking-wider px-4 py-3" style="color: var(--fg-subtle);"></th>
            </tr>
          </thead>
          <tbody id="publisher-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script client>
  (function() {
    var loading = document.getElementById('publisher-loading')
    var retry = document.getElementById('publisher-retry')
    function text(value) {
      var element = document.createElement('span')
      element.textContent = String(value == null ? '' : value)
      return element.innerHTML
    }
    function load() {
      loading.hidden = false
      loading.textContent = 'Loading your packages…'
      loading.setAttribute('role', 'status')
      retry.hidden = true
      fetch('/publisher/api/packages')
        .then(function(response) {
          if (response.status === 401) { window.location.assign('/login?next=%2Fpublisher'); return null }
          if (!response.ok) throw new Error('Unable to load packages. Please try again.')
          return response.json()
        })
        .then(function(data) {
          if (!data) return
          loading.hidden = true
          document.getElementById('publisher-empty').style.display = data.packages.length ? 'none' : 'block'
          document.getElementById('publisher-list').style.display = data.packages.length ? 'block' : 'none'
          if (data.admin) document.getElementById('publisher-subtitle').textContent = 'Admin view — all registry packages'
          var body = document.getElementById('publisher-tbody')
          body.replaceChildren()
          var fragment = document.createDocumentFragment()
          data.packages.forEach(function(pkg) {
            var row = document.createElement('tr')
            row.className = 'border-t border-[var(--border)]'
            row.innerHTML =
              '<td class="px-4 py-3"><a href="/publisher/package/' + encodeURIComponent(pkg.name) + '" class="font-mono text-sm font-medium hvr-accent">' + text(pkg.name) + '</a>' +
              (pkg.description ? '<p class="text-xs mt-0.5" style="color:var(--fg-subtle);max-width:20rem;overflow-wrap:anywhere">' + text(pkg.description) + '</p>' : '') + '</td>' +
              '<td class="px-4 py-3 font-mono text-xs">' + text(pkg.latestVersion || '—') + '</td>' +
              '<td class="px-4 py-3 text-right text-xs">' + Number(pkg.totalDownloads || 0).toLocaleString() + '</td>' +
              '<td class="px-4 py-3 text-right text-xs">' + Number(pkg.commitCount || 0) + '</td>' +
              '<td class="px-4 py-3 text-right text-xs">' + text((pkg.updatedAt || '').split('T')[0]) + '</td>' +
              '<td class="px-4 py-3 text-right"><a href="/package/' + encodeURIComponent(pkg.name) + '" class="text-xs hvr-fg">public</a></td>'
            fragment.appendChild(row)
          })
          body.appendChild(fragment)
        })
        .catch(function() {
          loading.textContent = 'Unable to load packages. Please try again.'
          loading.setAttribute('role', 'alert')
          retry.hidden = false
        })
    }
    retry.addEventListener('click', load)
    load()
  })()
</script>
