
<section class="py-12 px-6 pb-20">
  <div class="max-w-2xl mx-auto">
    <a href="/" class="inline-flex items-center gap-1.5 mb-6 hvr-fg transition-colors" style="font-size: 0.8125rem; color: var(--fg-subtle);">&larr; back</a>

    <div class="mb-6 animate-fade-in">
      <p class="uppercase tracking-widest mb-2" style="font-size: 0.6875rem; color: var(--fg-subtle);">Private package · for sale</p>
      <h1 class="font-mono text-2xl font-semibold mb-2" style="overflow-wrap: anywhere;">{{ name }}</h1>
      @if (publisher)
      <p style="font-size: 0.8125rem; color: var(--fg-subtle);">by {{ publisher }}</p>
      @endif
      @if (description)
      <p class="mt-4" style="font-size: 0.9375rem; color: var(--fg-muted);">{{ description }}</p>
      @endif
    </div>

    @if (isDeprecated)
    <div class="border rounded-lg p-4 mb-6 animate-fade-in-delay" role="note" aria-label="Deprecated package" data-deprecated style="background: var(--bg-subtle); border-color: var(--yellow);">
      <p class="uppercase tracking-widest mb-1 font-semibold" style="font-size: 0.6875rem; color: var(--yellow);">Deprecated</p>
      <p style="font-size: 0.9375rem; color: var(--fg); overflow-wrap: anywhere;">{{ deprecationNotice }}</p>
      <p class="mt-1" style="font-size: 0.8125rem; color: var(--fg-subtle);">Its owner has retired this package. Existing versions still install, with a warning.</p>
    </div>
    @endif

    <div class="border rounded-lg p-5 animate-fade-in-delay" style="background: var(--bg-subtle); border-color: var(--accent);">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-2xl font-semibold" style="color: var(--accent);">{{ priceLabel }}</p>
          <p class="mt-1" style="font-size: 0.8125rem; color: var(--fg-muted);">
            One payment, tied to your account — install it on every machine you sign in from.
          </p>
        </div>
        <div class="flex flex-col gap-2 items-stretch">
          <a href="{{ buyUrl }}" class="rounded-lg px-5 py-2.5 font-medium text-sm text-center transition-colors" style="background: var(--accent); color: var(--bg);">
            Buy for {{ priceLabel }}
          </a>
          <div class="flex items-center justify-between gap-3 bg-[var(--bg)] rounded-md px-3 py-2 border border-[var(--border)]">
            <code class="text-xs" style="color: var(--fg-muted);">pantry buy {{ name }}</code>
            <button class="copy-btn" data-copy="pantry buy {{ name }}">copy</button>
          </div>
        </div>
      </div>
    </div>

    <p class="mt-6" style="font-size: 0.8125rem; color: var(--fg-subtle);">
      This package is private. Its versions and contents are available once you've bought it.
      <a href="/paid-packages" class="hvr-accent transition-colors" style="color: var(--accent);">How paid packages work</a>
    </p>
  </div>
</section>
