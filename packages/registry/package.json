{
  "name": "@stacksjs/registry",
  "version": "0.11.35",
  "type": "module",
  "description": "Pantry package registry backend - S3 storage with DynamoDB metadata",
  "author": "Stacks.js",
  "license": "MIT",
  "homepage": "https://github.com/pantry-pm/pantry/tree/main/packages/registry#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/pantry-pm/pantry.git",
    "directory": "packages/registry"
  },
  "bugs": {
    "url": "https://github.com/pantry-pm/pantry/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build --production ./src/index.ts --outdir ./dist --target bun && bun run build:server",
    "build:server": "bun build --production ./src/server.ts --outfile ./dist/server.js --target bun && bun build --production ./src/scanner-worker.ts --outfile ./dist/scanner-worker.js --target bun",
    "prepublishOnly": "bun run build",
    "dev": "bun run --watch src/server.ts",
    "start": "NODE_ENV=production bun run dist/server.js",
    "test": "bun test",
    "test:analytics": "bun test src/analytics.test.ts",
    "test:commit-publish": "bun test src/commit-publish.test.ts",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@stacksjs/stx": "^0.2.82",
    "@ts-charts/array": "^0.2.0",
    "@ts-charts/format": "^0.2.0",
    "@ts-charts/path": "^0.2.0",
    "@ts-charts/scale": "^0.2.0",
    "@ts-charts/shape": "^0.2.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^7.0.2"
  }
}
