# Pantry Registry Configuration

# Server
PORT=3000
BASE_URL=https://registry.yourdomain.com

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Storage (for tarballs)
S3_BUCKET=pantry-registry-packages

# DynamoDB (for metadata)
DYNAMODB_TABLE=pantry-registry-metadata
DYNAMODB_ANALYTICS_TABLE=pantry-registry-analytics

# npm Fallback (set to false to disable)
NPM_FALLBACK=true

# Stripe (for package paywalls — optional)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Authentication
# Legacy admin token for CI publish (default: ABCD1234)
# PANTRY_REGISTRY_TOKEN=your-admin-token
# User auth uses the same DynamoDB table as metadata (DYNAMODB_TABLE above)

# Publish-time malware scanning (required by default in production)
PANTRY_MALWARE_SCANNING=required
PANTRY_REQUIRE_MALWARE_SCAN_ATTESTATION=true
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=30000
CLAMD_MAX_BYTES=1073741824
CLAMD_CHUNK_BYTES=65536

# Native binaries upload to an untrusted staging prefix and are promoted only
# after a clean scan. Use an independent random 32-byte secret in production.
PANTRY_BINARY_STAGING_SECRET=replace-with-openssl-rand-hex-32
PANTRY_REQUIRE_BINARY_SCAN_ATTESTATION=true
