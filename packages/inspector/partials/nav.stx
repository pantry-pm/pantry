<header class="sticky top-0 z-50 border-b border-[var(--border)]">
  <div class="absolute inset-0" style="background: oklch(0.171 0 0 / 0.8); backdrop-filter: blur(12px);"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14">
    <div class="flex items-center gap-5">
      <a href="/" class="flex items-center gap-1 mono text-lg font-medium" style="color: var(--fg);">
        <span style="color: var(--accent);">pantry</span>
        <span class="font-normal text-sm" style="color: var(--fg-subtle);">inspector</span>
      </a>
      <nav class="flex items-center gap-1 overflow-x-auto">
        <a href="/modules" class="mono inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium border transition-colors whitespace-nowrap" style="{!! active === 'modules' ? 'color: var(--fg); background: var(--bg-subtle); border-color: var(--border);' : 'color: var(--fg-muted); border-color: transparent;' !!}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12"/></svg>
          node_modules
        </a>
        <a href="/builds" class="mono inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium border transition-colors whitespace-nowrap" style="{!! active === 'builds' ? 'color: var(--fg); background: var(--bg-subtle); border-color: var(--border);' : 'color: var(--fg-muted); border-color: transparent;' !!}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 6-6 6 6 6"/><path d="m16 6 6 6-6 6"/></svg>
          Builds
        </a>
        <a href="/waste" class="mono inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium border transition-colors whitespace-nowrap" style="{!! active === 'waste' ? 'color: var(--fg); background: var(--bg-subtle); border-color: var(--border);' : 'color: var(--fg-muted); border-color: transparent;' !!}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/><path d="M12 9v4m0 4h.01"/></svg>
          Waste
        </a>
        <a href="/" class="mono inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium border transition-colors whitespace-nowrap" style="{!! active === 'grid' ? 'color: var(--fg); background: var(--bg-subtle); border-color: var(--border);' : 'color: var(--fg-muted); border-color: transparent;' !!}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          Pantry
        </a>
        <a href="/graph" class="mono inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium border transition-colors whitespace-nowrap" style="{!! active === 'graph' ? 'color: var(--fg); background: var(--bg-subtle); border-color: var(--border);' : 'color: var(--fg-muted); border-color: transparent;' !!}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4"/></svg>
          Graph
        </a>
        <a href="/report" class="mono inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-sm font-medium border transition-colors whitespace-nowrap" style="{!! active === 'report' ? 'color: var(--fg); background: var(--bg-subtle); border-color: var(--border);' : 'color: var(--fg-muted); border-color: transparent;' !!}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          Report
        </a>
      </nav>
    </div>
    <div class="mono text-xs hidden sm:block" style="color: var(--fg-subtle);">{{ projectName }}</div>
  </div>
</header>
