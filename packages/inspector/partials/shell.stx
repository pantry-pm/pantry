<style>
  :root {
    --bg: oklch(0.171 0 0); --bg-subtle: oklch(0.198 0 0); --bg-muted: oklch(0.236 0 0); --bg-elevated: oklch(0.266 0 0);
    --fg: oklch(0.982 0 0); --fg-muted: oklch(0.749 0 0); --fg-subtle: oklch(0.673 0 0);
    --border: oklch(0.269 0 0); --border-hover: oklch(0.371 0 0);
    --accent: oklch(0.787 0.128 230.318); --accent-subtle: oklch(0.787 0.128 230.318 / 0.12);
    --green: oklch(0.792 0.153 166.95); --green-subtle: oklch(0.792 0.153 166.95 / 0.12);
    --amber: oklch(0.828 0.165 84.429); --amber-subtle: oklch(0.828 0.165 84.429 / 0.12);
    --purple: oklch(0.78 0.148 286.067); --purple-subtle: oklch(0.78 0.148 286.067 / 0.12);
    --red: oklch(0.704 0.177 14.75); --red-subtle: oklch(0.704 0.177 14.75 / 0.12);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { font-family: 'Geist Variable', system-ui, -apple-system, sans-serif; background: var(--bg); color: var(--fg); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; text-rendering: optimizeLegibility; font-size: 15px; }
  body { min-height: 100vh; line-height: 1.6; }
  a { color: inherit; text-decoration: none; }
  .mono { font-family: 'Geist Mono Variable', monospace; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  ::selection { background-color: var(--fg-muted); color: var(--bg-subtle); }
  * { scrollbar-color: var(--border) var(--bg); }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--border-hover); }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  .fade-in { animation: fadeIn 0.3s ease-out; }
  .search-input { background: var(--bg-muted); border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px; color: var(--fg); font-family: 'Geist Mono Variable', monospace; font-size: 13px; width: 100%; outline: none; transition: border-color 0.2s; }
  .search-input:focus { border-color: var(--accent); }
  .search-input::placeholder { color: var(--fg-subtle); }
  .card { background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 10px; }
  .stat-label { font-family: 'Geist Mono Variable', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg-subtle); }
  .stat-value { font-family: 'Geist Mono Variable', monospace; font-size: 22px; font-weight: 600; line-height: 1.2; }
  .bar { height: 6px; border-radius: 3px; background: var(--bg-muted); overflow: hidden; }
  .bar > span { display: block; height: 100%; background: var(--accent); }
  .tag { display: inline-flex; align-items: center; gap: 4px; padding: 2px 7px; border-radius: 5px; font-family: 'Geist Mono Variable', monospace; font-size: 11px; border: 1px solid var(--border); color: var(--fg-subtle); }
  .tag.warn { color: var(--amber); border-color: var(--amber); background: var(--amber-subtle); }
  .tag.bad { color: var(--red); border-color: var(--red); background: var(--red-subtle); }
  .tag.good { color: var(--green); border-color: var(--green); background: var(--green-subtle); }
  table { width: 100%; border-collapse: collapse; }
  th { font-family: 'Geist Mono Variable', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg-subtle); text-align: left; font-weight: 500; padding: 8px 12px; border-bottom: 1px solid var(--border); white-space: nowrap; }
  th.num, td.num { text-align: right; }
  td { padding: 8px 12px; border-bottom: 1px solid var(--border); font-size: 13px; vertical-align: top; }
  tbody tr:hover { background: var(--bg-muted); }
  .num { font-family: 'Geist Mono Variable', monospace; font-variant-numeric: tabular-nums; }
</style>
