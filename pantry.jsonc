{
  "name": "pantry",
  "version": "1.0.0",
  "description": "Modern dependency manager for system and project environments - Like Homebrew but faster",
  "dependencies": {
    "zig-config": { "version": "f2feb1fdc262be4b8dc14d63113024ce0ab89927", "source": "github", "repo": "zig-utils/zig-config" },
    "zig-cli": { "version": "4629d10a7e8aa6de9c26996109138683235a2273", "source": "github", "repo": "zig-utils/zig-cli" },
    "zig-test-framework": { "version": "c149e957e3989bdb8f9148a161f6eef4ae63d75e", "source": "github", "repo": "zig-utils/zig-test-framework" },
    "zig-bump": { "version": "15ddba7d124d32dbb7884dd74ec942baced2d6bf", "source": "github", "repo": "zig-utils/zig-bump" },
    "bun.sh": "^1.3.10",
    "ziglang.org": "0.17.0-dev"
  },
  "devDependencies": {
    "better-dx": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stacksjs/pantry"
  },
  "build": {
    "entry": "packages/zig/src/main.zig",
    "output": "packages/zig/zig-out",
    "targets": [
      "x86_64-linux",
      "x86_64-macos",
      "aarch64-macos",
      "x86_64-windows"
    ]
  },
  "workspaces": [
    "packages/*"
  ]
}
